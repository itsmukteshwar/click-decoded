# ─────────────────────────────────────────────
# Click Decoded — Environment Variables
# Copy this file to .env.local and fill values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────

# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.clickdecoded.com

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# WhatsApp number (country code + number, no + or spaces)
NEXT_PUBLIC_WA_NUMBER=919407000101

# Zoho SMTP (contact + careers form emails)
ZOHO_EMAIL=hello@clickdecoded.com
ZOHO_APP_PASSWORD=your_zoho_app_password
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465

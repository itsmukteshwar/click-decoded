        "availableLanguage": ["English", "Hindi"]
      },
      "knowsAbout": [
        "Search Engine Optimization", "Local SEO", "Programmatic SEO", "Google Ads", "Meta Ads",
        "Generative Engine Optimization", "Answer Engine Optimization", "WhatsApp Business API",
        "n8n workflow automation", "AI chatbots", "WordPress development", "White label SEO"
      ],
      "sameAs": [
        "https://www.google.com/maps?cid=REPLACE_GBP_CID",
        "https://www.linkedin.com/company/REPLACE",
        "https://www.facebook.com/REPLACE",
        "https://www.instagram.com/REPLACE",
        "https://clutch.co/profile/REPLACE"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.clickdecoded.com/#website",
